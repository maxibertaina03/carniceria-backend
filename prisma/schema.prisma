// Esquema de la base de datos de la carnicería.
// Tablas y columnas en español, snake_case (convención PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnidadMedida {
  KG
  GRAMO
  METRO
  UNIDAD

  @@map("unidad_medida")
}

enum FormaPago {
  CONTADO
  FIADO
  MIXTO

  @@map("forma_pago")
}

enum EstadoPedido {
  PENDIENTE
  ENTREGADO
  CANCELADO

  @@map("estado_pedido")
}

enum TipoMovimiento {
  CARGO
  PAGO

  @@map("tipo_movimiento")
}

model Producto {
  id                      String            @id @default(uuid())
  nombre                  String
  categoria               String            @map("categoria")
  // Detalle opcional dentro de la categoría (ej. milanesa "de cerdo").
  subcategoria            String?
  unidadMedida            UnidadMedida      @default(KG) @map("unidad_medida")
  stockActual             Decimal           @default(0) @map("stock_actual") @db.Decimal(12, 3)
  costoUnitarioReferencia Decimal           @default(0) @map("costo_unitario_referencia") @db.Decimal(12, 2)
  precioVentaReferencia   Decimal           @default(0) @map("precio_venta_referencia") @db.Decimal(12, 2)
  // Si es false, no aparece en la pantalla de Ventas (insumos, cortes intermedios).
  seVende                 Boolean           @default(true) @map("se_vende")
  // Días que dura el producto desde su elaboración (para lotes con vencimiento;
  // solo se usa en rubros con la función de lotes activada). Null = no vence.
  diasVencimiento         Int?              @map("dias_vencimiento")
  activo                  Boolean           @default(true)
  fechaCreacion           DateTime          @default(now()) @map("fecha_creacion")

  itemsCompra         ItemCompra[]
  itemsVenta          ItemVenta[]
  itemsDesposte       ItemDesposte[]
  recetas             Receta[]
  ingredientesReceta  IngredienteReceta[]
  ordenesProduccion   OrdenProduccion[]
  itemsProduccion     ItemProduccion[]
  itemsPedido         ItemPedido[]
  lotes               Lote[]
  presentaciones      Presentacion[]

  @@map("productos")
}

// Presentación de venta de un producto (½ kg, 1 kg, docena…). Solo se usa en
// rubros con la función activada. Al vender una presentación, se descuenta del
// stock base la cantidad equivalente y se cobra su precio.
model Presentacion {
  id                  String   @id @default(uuid())
  productoId          String   @map("producto_id")
  nombre              String
  // Cuánto del stock base (en la unidad del producto) equivale 1 presentación.
  cantidadEquivalente Decimal  @map("cantidad_equivalente") @db.Decimal(12, 3)
  precio              Decimal  @db.Decimal(12, 2)
  activo              Boolean  @default(true)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("presentaciones")
}

// Lote de stock con fecha de elaboración y vencimiento. Se usa solo cuando el
// rubro tiene la función de lotes activada (ej. fábrica de pastas). El stock se
// descuenta primero de los lotes que vencen antes (FIFO por vencimiento).
model Lote {
  id                 String    @id @default(uuid())
  productoId         String    @map("producto_id")
  fechaElaboracion   DateTime  @default(now()) @map("fecha_elaboracion")
  fechaVencimiento   DateTime? @map("fecha_vencimiento")
  cantidadInicial    Decimal   @map("cantidad_inicial") @db.Decimal(12, 3)
  cantidadDisponible Decimal   @map("cantidad_disponible") @db.Decimal(12, 3)

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, cantidadDisponible])
  @@map("lotes")
}

model Compra {
  id            String   @id @default(uuid())
  fecha         DateTime @default(now())
  // Nombre suelto del proveedor (compra rápida sin cuenta).
  proveedor     String?
  // Proveedor con cuenta corriente (opcional). Si queda algo adeudado, se
  // registra en su cuenta.
  proveedorId   String?  @map("proveedor_id")
  total         Decimal  @db.Decimal(12, 2)
  // Cuánto de esta compra quedó a deber (0 = se pagó todo al contado).
  montoAdeudado Decimal  @default(0) @map("monto_adeudado") @db.Decimal(12, 2)
  observaciones String?

  items          ItemCompra[]
  proveedorCta   Proveedor?         @relation(fields: [proveedorId], references: [id])
  movimientos    MovimientoProveedor[]

  @@map("compras")
}

model ItemCompra {
  id            String  @id @default(uuid())
  compraId      String  @map("compra_id")
  productoId    String  @map("producto_id")
  cantidad      Decimal @db.Decimal(12, 3)
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("items_compra")
}

model Venta {
  id            String    @id @default(uuid())
  fecha         DateTime  @default(now())
  clienteId     String?   @map("cliente_id")
  total         Decimal   @db.Decimal(12, 2)
  montoContado  Decimal   @map("monto_contado") @db.Decimal(12, 2)
  montoFiado    Decimal   @map("monto_fiado") @db.Decimal(12, 2)
  formaPago     FormaPago @map("forma_pago")
  observaciones String?

  items       ItemVenta[]
  cliente     Cliente?           @relation(fields: [clienteId], references: [id])
  movimientos MovimientoCuenta[]

  @@map("ventas")
}

model ItemVenta {
  id                  String  @id @default(uuid())
  ventaId             String  @map("venta_id")
  productoId          String  @map("producto_id")
  cantidad            Decimal @db.Decimal(12, 3)
  precioUnitarioVenta Decimal @map("precio_unitario_venta") @db.Decimal(12, 2)
  // Costo del producto al momento de la venta (snapshot): la ganancia histórica
  // no cambia aunque después cambie el costo de referencia del producto.
  costoUnitario       Decimal @map("costo_unitario") @db.Decimal(12, 2)
  subtotal            Decimal @db.Decimal(12, 2)
  gananciaLinea       Decimal @map("ganancia_linea") @db.Decimal(12, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("items_venta")
}

model Cliente {
  id            String   @id @default(uuid())
  nombre        String
  telefono      String?
  saldoDeudor   Decimal  @default(0) @map("saldo_deudor") @db.Decimal(12, 2)
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  ventas      Venta[]
  movimientos MovimientoCuenta[]
  pedidos     Pedido[]

  @@map("clientes")
}

model MovimientoCuenta {
  id            String         @id @default(uuid())
  clienteId     String         @map("cliente_id")
  tipo          TipoMovimiento
  monto         Decimal        @db.Decimal(12, 2)
  fecha         DateTime       @default(now())
  ventaId       String?        @map("venta_id")
  observaciones String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
  venta   Venta?  @relation(fields: [ventaId], references: [id])

  @@map("movimientos_cuenta")
}

// --- Desposte: se compra una media res y se desarma en cortes ---

model Desposte {
  id            String   @id @default(uuid())
  fecha         DateTime @default(now())
  proveedor     String?
  pesoRes       Decimal  @map("peso_res") @db.Decimal(12, 3)
  costoTotal    Decimal  @map("costo_total") @db.Decimal(12, 2)
  observaciones String?

  cortes ItemDesposte[]

  @@map("despostes")
}

model ItemDesposte {
  id         String  @id @default(uuid())
  desposteId String  @map("desposte_id")
  productoId String  @map("producto_id")
  cantidad   Decimal @db.Decimal(12, 3)
  // Valor por kg que el usuario le asigna al corte; reparte el costo de la res.
  valorReferencia Decimal @map("valor_referencia") @db.Decimal(12, 2)
  // Costo por kg calculado que se asignó al corte al despostar (snapshot).
  costoUnitario   Decimal @map("costo_unitario") @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  desposte Desposte @relation(fields: [desposteId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("items_desposte")
}

// --- Producción propia: recetas y órdenes de producción de embutidos ---

model Receta {
  id                  String  @id @default(uuid())
  productoTerminadoId String  @unique @map("producto_terminado_id")
  // Cantidad de producto terminado que rinde esta fórmula (ej. 10 = por cada 10 kg).
  rindeCantidad       Decimal @map("rinde_cantidad") @db.Decimal(12, 3)
  activa              Boolean @default(true)

  productoTerminado Producto            @relation(fields: [productoTerminadoId], references: [id])
  ingredientes      IngredienteReceta[]

  @@map("recetas")
}

model IngredienteReceta {
  id         String  @id @default(uuid())
  recetaId   String  @map("receta_id")
  productoId String  @map("producto_id")
  // Cantidad del ingrediente por el rinde base de la receta, expresada en la
  // unidad de abajo (ej. 28 GRAMO de una sal que se compra y stockea por KG).
  cantidad   Decimal @db.Decimal(12, 3)
  // Unidad en la que se carga la cantidad; se convierte a la del producto
  // para descontar stock y calcular el costo.
  unidad     UnidadMedida @default(KG)

  receta   Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("ingredientes_receta")
}

model OrdenProduccion {
  id                  String   @id @default(uuid())
  fecha               DateTime @default(now())
  productoTerminadoId String   @map("producto_terminado_id")
  cantidadProducida   Decimal  @map("cantidad_producida") @db.Decimal(12, 3)
  costoTotal          Decimal  @map("costo_total") @db.Decimal(12, 2)
  costoUnitario       Decimal  @map("costo_unitario") @db.Decimal(12, 2)
  observaciones       String?

  productoTerminado Producto         @relation(fields: [productoTerminadoId], references: [id])
  items             ItemProduccion[]

  @@map("ordenes_produccion")
}

model ItemProduccion {
  id         String  @id @default(uuid())
  ordenId    String  @map("orden_id")
  productoId String  @map("producto_id")
  cantidad   Decimal @db.Decimal(12, 3)
  // Costo del ingrediente al momento de producir (snapshot).
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  orden    OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto Producto        @relation(fields: [productoId], references: [id])

  @@map("items_produccion")
}

// --- Pedidos: encargos que hace la gente y todavía no se pagaron ---
// Un pedido es un compromiso a futuro: no mueve stock ni plata. Al entregarlo
// se confirma con los pesos reales y se genera una venta (contado/fiado/mixto).

model Pedido {
  id             String       @id @default(uuid())
  fecha          DateTime     @default(now())
  // Para quién es. Puede apuntar a un cliente registrado o quedar como texto
  // libre (alguien que todavía no está en la lista de clientes).
  clienteId      String?      @map("cliente_id")
  nombreContacto String?      @map("nombre_contacto")
  telefono       String?
  fechaEntrega   DateTime?    @map("fecha_entrega")
  estado         EstadoPedido @default(PENDIENTE)
  observaciones  String?
  // Venta que se generó al entregarlo (referencia por id, sin FK entre contextos).
  ventaId        String?      @map("venta_id")

  cliente Cliente?     @relation(fields: [clienteId], references: [id])
  items   ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id         String  @id @default(uuid())
  pedidoId   String  @map("pedido_id")
  productoId String  @map("producto_id")
  // Cantidad y precio ESTIMADOS del encargo; los reales se confirman al entregar.
  cantidad       Decimal @db.Decimal(12, 3)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("items_pedido")
}

// --- Proveedores (cuentas por pagar): lo que YO debo ---
// Espejo de Cliente/MovimientoCuenta pero al revés: el saldo es lo que le debo.

model Proveedor {
  id            String   @id @default(uuid())
  nombre        String
  telefono      String?
  saldoAdeudado Decimal  @default(0) @map("saldo_adeudado") @db.Decimal(12, 2)
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  compras     Compra[]
  gastos      Gasto[]
  movimientos MovimientoProveedor[]

  @@map("proveedores")
}

model MovimientoProveedor {
  id            String         @id @default(uuid())
  proveedorId   String         @map("proveedor_id")
  tipo          TipoMovimiento // CARGO = deuda que genero ; PAGO = lo que le pago
  monto         Decimal        @db.Decimal(12, 2)
  fecha         DateTime       @default(now())
  compraId      String?        @map("compra_id")
  gastoId       String?        @map("gasto_id")
  observaciones String?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  compra    Compra?   @relation(fields: [compraId], references: [id])
  gasto     Gasto?    @relation(fields: [gastoId], references: [id])

  @@map("movimientos_proveedor")
}

// --- Facturación (módulo administrador, aislado): comprobantes internos ---
// Sin AFIP por ahora: letra "X" = documento interno sin validez fiscal.

enum TipoComprobante {
  FACTURA
  NOTA_CREDITO
  NOTA_DEBITO
  RECIBO

  @@map("tipo_comprobante")
}

enum EstadoComprobante {
  EMITIDO
  ANULADO

  @@map("estado_comprobante")
}

model Comprobante {
  id         String          @id @default(uuid())
  tipo       TipoComprobante
  letra      String          @default("X")
  puntoVenta String          @default("0001") @map("punto_venta")
  numero     Int
  fecha      DateTime        @default(now())

  // Receptor (a quién se le factura). Campos libres para clientes grandes.
  receptorNombre    String  @map("receptor_nombre")
  receptorDocTipo   String? @map("receptor_doc_tipo")
  receptorDocNumero String? @map("receptor_doc_numero")
  receptorDomicilio String? @map("receptor_domicilio")

  neto        Decimal @db.Decimal(12, 2)
  alicuotaIva Decimal @default(0) @map("alicuota_iva") @db.Decimal(5, 2)
  iva         Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  observaciones String?
  estado        EstadoComprobante @default(EMITIDO)

  // Comprobante de origen (para notas de crédito/débito sobre una factura).
  comprobanteOrigenId String? @map("comprobante_origen_id")

  items             ItemComprobante[]
  comprobanteOrigen Comprobante?      @relation("OrigenComprobante", fields: [comprobanteOrigenId], references: [id])
  derivados         Comprobante[]     @relation("OrigenComprobante")

  @@unique([tipo, puntoVenta, letra, numero])
  @@map("comprobantes")
}

model ItemComprobante {
  id             String  @id @default(uuid())
  comprobanteId  String  @map("comprobante_id")
  descripcion    String
  cantidad       Decimal @db.Decimal(12, 3)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@map("items_comprobante")
}

// --- Gastos del negocio (no mercadería): alquiler, luz, sueldos, etc. ---

model Gasto {
  id            String    @id @default(uuid())
  fecha         DateTime  @default(now())
  concepto      String
  categoria     String?
  monto         Decimal   @db.Decimal(12, 2)
  // Si es adeudado, se registra en la cuenta del proveedor de abajo.
  adeudado      Boolean   @default(false)
  // Fecha en que vence la boleta (solo tiene sentido si está adeudada).
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  // Si la boleta ya se pagó. Los gastos al contado nacen pagados.
  pagado        Boolean   @default(true)
  proveedorId   String?   @map("proveedor_id")
  observaciones String?

  proveedor   Proveedor?            @relation(fields: [proveedorId], references: [id])
  movimientos MovimientoProveedor[]

  @@map("gastos")
}
