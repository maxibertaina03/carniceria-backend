# Connection string de PostgreSQL.
# - Desarrollo local (Docker): la de abajo funciona tal cual con `docker compose up -d`.
# - Producción (Supabase): copiar la "Connection string" (URI) desde el panel de Supabase
#   (Project Settings → Database → Connection string) y reemplazarla acá.
DATABASE_URL="postgresql://carniceria:carniceria@localhost:5433/carniceria?schema=public"

# Puerto donde escucha la API (Render define PORT automáticamente).
PORT=3000
